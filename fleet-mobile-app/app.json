{
  "expo": {
    "name": "Smart Axia Fleet Manager",
    "slug": "Smart-Axia-Fleet-Manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-black.png",
    "scheme": "fleetmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.islemboubaker.SmartAxiaFleetManager"
    },
    "android": {
      "icon": "./assets/images/app-icon-black.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-black.png",
        "backgroundColor": "#000000"
      },
      "package": "com.islemboubaker.SmartAxiaFleetManager",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-black.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo-black.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "03ec7089-4dbf-4016-9075-4a0ea31614f3"
      }
    },
    "owner": "bedis_gh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/03ec7089-4dbf-4016-9075-4a0ea31614f3",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
